{
  "name": "@hwameistor/release-assistant",
  "version": "0.1.0",
  "description": "Generate evidence-backed release pull requests with Copilot or a custom model endpoint",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "release-assistant": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.26",
    "semver": "7.7.3",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/semver": "7.7.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
